# Copy this file to `.env` and fill in your values:
# cp examples/16_self_host_sandbox/.env.example examples/16_self_host_sandbox/.env

# --- Volcengine & LLM Credentials ---
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key
X_TOP_ACCOUNT_ID=your_volcengine_account_id

# Optional: Model provider configuration (defaults to Ark Doubao)
# MODEL_AGENT_PROVIDER=openai
# MODEL_AGENT_NAME=doubao-seed-1-6-250615
# MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
# MODEL_AGENT_API_KEY=your_ark_api_key

# --- Anthropic & Self-Hosted Sandbox Gateway Configuration ---
ANTHROPIC_BASE_URL=https://<your-apig-gateway-domain>.apigateway-cn-beijing.volceapi.com
ANTHROPIC_ENVIRONMENT_ID=env_your_sandbox_environment_id
ANTHROPIC_ENVIRONMENT_KEY=your_bearer_token_or_api_key

# --- Optional Worker & Agent Overrides ---
# SANDBOX_BASH_TOOL_NAME=bash
# ANTHROPIC_WORKER_ID=worker_01
# ANTHROPIC_WORKDIR=/tmp/omaworkspace
