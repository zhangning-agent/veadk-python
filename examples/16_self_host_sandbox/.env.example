# Copy this file to `.env` and fill in your values:
# cp examples/16_self_host_sandbox/.env.example examples/16_self_host_sandbox/.env

# --- Managed Runtime connection ---
# BOE Runtime 7hw8g3yr exposes its Managed Sessions gateway through this URL.
ANTHROPIC_BASE_URL=https://<runtime-apig-domain>.apigateway-cn-beijing.volceapi.com
MANAGED_AGENT_API_MODE=oma
# ByteDance APIG uses Authorization: Bearer instead of the OMA x-api-key default.
MANAGED_AGENT_AUTH_HEADER=authorization
# Release an idle local Tool container while keeping the Dispatcher running.
WORKER_MAX_IDLE=180s
# Used by the local split gateway and ma-server as the Session/Event upstream.
# TASK_SERVER_BASE_URL=https://<runtime-apig-domain>.apigateway-cn-beijing.volceapi.com
ANTHROPIC_ENVIRONMENT_ID=env_your_runtime_environment_id
ANTHROPIC_ENVIRONMENT_KEY=your_runtime_environment_key
# Injected automatically when a WorkItem starts Agent Loop mode.
# ANTHROPIC_SESSION_ID=session_existing_managed_session_id
SANDBOX_AGENT_ID=agent_your_managed_agent_id
X_TOP_ACCOUNT_ID=your_volcengine_account_id

# --- Shared VeADK session state (required for Managed Agent Loop mode) ---
# Either set one complete URL or the DATABASE_POSTGRESQL_* fields below.
VEADK_MANAGED_SESSION_DB_URL=postgresql+asyncpg://veadk:veadk@127.0.0.1:55432/veadk
# DATABASE_POSTGRESQL_HOST=127.0.0.1
# DATABASE_POSTGRESQL_PORT=55432
# DATABASE_POSTGRESQL_USER=veadk
# DATABASE_POSTGRESQL_PASSWORD=veadk
# DATABASE_POSTGRESQL_DATABASE=veadk
# DATABASE_POSTGRESQL_SCHEMA=managed_agents
# POSTGRES_PORT=55432
# MANAGED_AGENTS_GATEWAY_PORT=18080
# Localhost-only ma-server endpoint used by official Environment Work clients.
# MA_SERVER_PORT=18081
# Working directory for tools executed by the work-driven VeADK worker.
# MANAGED_AGENT_WORKDIR=/workspace
# MA_SERVER_API_TOKEN is for browser/control-plane management only. Agent Loop
# Workers download Session-pinned Skills with the Work-scoped token.
# MA_SERVER_API_TOKEN=replace-me
# AGENTKIT_SKILL_SPACE_IDS=ss-your-skill-space-id

# --- Web Server Configuration ---
PORT=8067
# Comma-separated origins when the Dev UI is accessed through another origin.
# ALLOW_ORIGINS=http://localhost:3000,https://your-dev-proxy.example.com

# Maximum time to wait for a remote Runtime turn, including tool execution.
# SANDBOX_TIMEOUT_SECONDS=300

# --- Feishu bot channel ---
# Configure the Feishu app to receive messages through WebSocket events.
TOOL_FEISHU_CHANNEL_APP_ID=cli_your_feishu_app_id
TOOL_FEISHU_CHANNEL_APP_SECRET=your_feishu_app_secret
TOOL_FEISHU_CHANNEL_TRANSPORT=ws
TOOL_FEISHU_CHANNEL_STREAMING=true
TOOL_FEISHU_CHANNEL_REACTIONS=true
# The demo enables these in code. They are also available as extension-level
# environment switches for other FeishuChannelExtension integrations.
TOOL_FEISHU_CHANNEL_SHOW_THINKING=true
TOOL_FEISHU_CHANNEL_SHOW_TOOL_CALLS=true
TOOL_FEISHU_CHANNEL_SHOW_TOOL_RESULTS=true
TOOL_FEISHU_CHANNEL_SEPARATE_TOOL_CALL_CARDS=true
TOOL_FEISHU_CHANNEL_SEPARATE_THINKING_CARD=true
TOOL_FEISHU_CHANNEL_CREATE_TOPIC=true
